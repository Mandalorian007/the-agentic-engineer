# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold a real value.

# Buttondown API key, used by app/api/subscribe/route.ts to create subscribers.
# Without it the route runs in preview mode outside production: it logs the
# address to the server console and returns success without calling Buttondown.
# Production without it fails loudly rather than dropping addresses.
# Required in Vercel Production.
BUTTONDOWN_API_KEY=

# Shared secret for POST /api/revalidate, called by the publish workflows.
# Required in Vercel Production. Must match the GitHub Actions secret.
REVALIDATE_SECRET=

# Show scheduled posts and unsent issues at their own URLs, and in a clearly
# marked section of each listing.
#
#   true   always show them
#   false  never show them, even locally (use this to check what the public sees)
#   unset  show them outside production, which is what `next dev` wants
#
# Set to "true" on Vercel's Preview environment. Leave unset or "false" on
# Production, or scheduled content becomes publicly readable.
PREVIEW_UNPUBLISHED=
